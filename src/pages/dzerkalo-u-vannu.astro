---
import Layout from '../layouts/Layout.astro';
import LedCalculator from '../components/LedCalculator.astro';

const faq = [
  { q: 'Яке дзеркало краще у ванну — з фоновою чи фронтальною підсвіткою?', a: 'Для затишної атмосфери й ефекту «парящого» дзеркала беруть фонову підсвітку. Для яскравого рівномірного світла під макіяж і гоління — фронтальну. Можна поєднати обидва варіанти.' },
  { q: 'Чи не запотіває дзеркало у ванній?', a: 'Щоб дзеркало не запотівало після душу, додайте опцію підігріву (+400 грн) — нагрівальний елемент за дзеркалом тримає поверхню чистою й прозорою.' },
  { q: 'Чи безпечна LED-підсвітка у вологому приміщенні?', a: 'Так, ми використовуємо вологозахищені світлодіодні стрічки та компоненти, розраховані на ванну кімнату. Підключення виконується за нормами електробезпеки.' },
  { q: 'Який колір світла обрати для ванної?', a: 'Холодне 6000K — яскраве й функціональне, добре для макіяжу. Нейтральне 4000K — універсальне. Тепле 3000K — м’яке та затишне. Опційно можна додати дімер для регулювання яскравості.' },
  { q: 'Чи можна зробити дзеркало за моїм розміром і формою?', a: 'Так, дзеркала у ванну виготовляються за індивідуальними розмірами — прямокутні, круглі або із заокругленими кутами. Розрахуйте вартість у калькуляторі нижче.' },
  { q: 'Скільки коштує дзеркало у ванну з підсвіткою?', a: 'Ціна залежить від розміру, типу підсвітки та опцій. Точну вартість миттєво покаже онлайн-калькулятор на цій сторінці.' },
];

const breadcrumbs = [
  { name: 'Головна', path: '/' },
  { name: 'LED дзеркала', path: '/led-dzerkalo/' },
  { name: 'Дзеркало у ванну', path: '/dzerkalo-u-vannu/' },
];
---

<Layout
  title="Дзеркало у ванну з підсвіткою на замовлення — Київ | Євро Плитка"
  description="LED дзеркало у ванну кімнату з підсвіткою за вашим розміром. Фонова та фронтальна підсвітка, підігрів проти запотівання, сенсор. Калькулятор ціни онлайн."
  breadcrumbs={breadcrumbs}
  faq={faq}
>
  <div class="page-hero page-hero--dark">
    <div class="container">
      <div class="breadcrumb"><a href="/">Головна</a><span>›</span><a href="/led-dzerkalo/">LED дзеркала</a><span>›</span><span>Дзеркало у ванну</span></div>
      <div class="section-label">Для ванної кімнати</div>
      <h1>Дзеркало у ванну з підсвіткою</h1>
      <p class="hero-sub">Виготовлення за вашим розміром · підсвітка, підігрів проти запотівання, сенсор · Київ та вся Україна</p>
    </div>
  </div>

  <section class="section intro">
    <div class="container">
      <p class="intro-lead">Дзеркало з LED-підсвіткою — це не лише світло, а й атмосфера у ванній кімнаті. Ми виготовляємо дзеркала будь-яких розмірів і форм із вологозахищеною підсвіткою, а опція підігріву тримає поверхню чистою навіть після гарячого душу.</p>
      <div class="benefits">
        <div class="benefit"><span class="benefit__icon">◆</span><div><strong>Не запотіває</strong><p>Опція підігріву тримає дзеркало прозорим після душу</p></div></div>
        <div class="benefit"><span class="benefit__icon">◆</span><div><strong>Вологозахист</strong><p>LED-компоненти, розраховані на ванну кімнату</p></div></div>
        <div class="benefit"><span class="benefit__icon">◆</span><div><strong>Будь-яка форма</strong><p>Прямокутні, круглі, із заокругленими кутами</p></div></div>
        <div class="benefit"><span class="benefit__icon">◆</span><div><strong>Керування</strong><p>Сенсор увімкнення дотиком, дімер яскравості</p></div></div>
      </div>
    </div>
  </section>

  <section class="section calc-section">
    <div class="container">
      <div class="section-label">Онлайн-калькулятор</div>
      <h2>Розрахуйте ціну дзеркала у ванну</h2>
      <LedCalculator />
    </div>
  </section>

  <section class="section faq-section">
    <div class="container">
      <div class="section-label">Запитання та відповіді</div>
      <h2>Дзеркало у ванну — часті питання</h2>
      <div class="faq">
        {faq.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero--dark { background: var(--bg); border-bottom: 1px solid var(--border); padding: 40px 0 32px; }
  .page-hero--dark .breadcrumb { color: var(--text-muted); margin-bottom: 14px; font-size: 0.85rem; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .page-hero--dark .breadcrumb a { color: var(--text-muted); }
  .page-hero--dark h1 { font-size: clamp(1.6rem, 3.4vw, 2.4rem); color: var(--text); margin-bottom: 10px; }
  .hero-sub { color: var(--text-muted); font-size: 1rem; }

  .section-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold); margin-bottom: 8px; }

  .intro { background: var(--bg); padding-top: 32px; }
  .intro-lead { font-size: 1.05rem; color: var(--text-mid); line-height: 1.8; max-width: 70ch; margin-bottom: 28px; }
  .benefits { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .benefit { display: flex; gap: 12px; align-items: flex-start; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
  .benefit__icon { color: var(--gold); flex-shrink: 0; margin-top: 2px; }
  .benefit strong { display: block; color: var(--text); font-size: 0.95rem; margin-bottom: 4px; }
  .benefit p { color: var(--text-muted); font-size: 0.85rem; line-height: 1.6; margin: 0; }

  .calc-section { background: var(--bg); }
  .calc-section h2 { color: var(--text); margin-bottom: 18px; }

  .faq-section { background: var(--bg); }
  .faq-section h2 { color: var(--text); margin-bottom: 8px; }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  .faq-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 28px; transition: border-color 0.2s; }
  .faq-item:hover { border-color: rgba(201,168,76,0.3); }
  .faq-item h3 { margin-bottom: 10px; color: var(--gold); font-size: 1.05rem; }
  .faq-item p { font-size: 0.93rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  @media (max-width: 900px) { .benefits { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .faq { grid-template-columns: 1fr; } }
  @media (max-width: 460px) { .benefits { grid-template-columns: 1fr; } }
</style>
