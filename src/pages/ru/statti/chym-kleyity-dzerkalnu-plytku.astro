const faq = [
  { q: 'Чем клеить зеркальную плитку на стену?', a: 'Двумя способами: специальным нейтральным зеркальным клеем-герметиком или двусторонним монтажным скотчем для зеркал. Главное условие — клей должен быть нейтральным (не кислотным), иначе он повредит амальгаму и на зеркале проступят тёмные пятна.' },
  { q: 'Можно ли клеить зеркало на жидкие гвозди?', a: 'Только если на упаковке прямо указано «для зеркал» / «нейтральный». Обычные жидкие гвозди и силиконы часто содержат кислоту, которая разъедает обратное покрытие зеркала. Безопаснее брать специализированный зеркальный клей.' },
  { q: 'На какую стену можно клеить зеркальную плитку?', a: 'На ровную, сухую, чистую и прочную поверхность — окрашенную стену, гипсокартон, кафель, ОСБ. Неровности более 2 мм нужно выровнять, иначе отражение «поплывёт», а плитка ляжет с перекосом.' },
  { q: 'Нужна ли помощь мастера?', a: 'Небольшое панно можно наклеить самостоятельно. Но для больших площадей и раскроя ромбом лучше привлечь нашу бригаду — ровность рядов и стыков здесь критична для вида.' },
];
