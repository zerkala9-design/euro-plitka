---
import Layout from '../../layouts/Layout.astro';
import LedCalculator from '../../components/LedCalculator.astro';

const faq = [
  { q: 'В чём разница между фоновой и фронтальной подсветкой?', a: 'Фоновая подсветка размещена за зеркалом и создаёт мягкое атмосферное свечение вокруг (эффект «парящего» зеркала). Фронтальная подсветка встроена по периметру лицевой стороны и даёт равномерный яркий свет без теней — идеально для макияжа и бритья.' },
  { q: 'Сколько стоит LED зеркало на заказ?', a: 'Цена зависит от типа подсветки, формы, размера и дополнительных опций. Точную стоимость мгновенно рассчитает калькулятор на этой странице — выберите параметры и увидите сумму сразу.' },
  { q: 'Какой цвет подсветки выбрать?', a: 'Тёплый свет 3000K — уютный, для спальни. Нейтральный 4000K — универсальный. Холодный 6000K — яркий и функциональный, для ванной и гардеробной. Опционально доступен диммер для регулировки яркости.' },
  { q: 'Можно ли сделать зеркало по моему размеру?', a: 'Да, все LED зеркала изготавливаются по индивидуальным размерам под ваше помещение — прямоугольные или круглые, с закруглёнными углами по желанию.' },
  { q: 'Что такое подогрев и зачем он?', a: 'Подогрев (+400 грн) — это нагревательный элемент за зеркалом, который предотвращает запотевание в ванной после душа. Зеркало всегда остаётся чистым и прозрачным.' },
  { q: 'Сколько изготавливается LED зеркало?', a: 'Изготовление занимает 3–7 рабочих дней в зависимости от сложности и опций. Доставка по Киеву и по всей Украине.' },
];

const breadcrumbs = [
  { name: 'Главная', path: '/ru/' },
  { name: 'LED зеркала', path: '/ru/led-dzerkalo/' },
];
---

<Layout
  lang="ru"
  title="LED зеркало с подсветкой — калькулятор цены, Киев"
  description="LED зеркало с подсветкой на заказ: выберите тип, размер, цвет света, подогрев и сенсор — и увидите цену сразу. Изготовление 3-7 дней, доставка по Украине."
  breadcrumbs={breadcrumbs}
  faq={faq}
  product={{ name: 'LED зеркало с подсветкой', lowPrice: 3120 }}
>
  <div class="page-hero page-hero--dark">
    <div class="container">
      <div class="breadcrumb"><a href="/ru/">Главная</a><span>›</span><span>LED зеркала</span></div>
      <div class="section-label">Изготовление на заказ</div>
      <h1>Premium LED зеркала на заказ</h1>
      <p class="hero-sub">Фоновая и фронтальная подсветка · любые размеры · изготовление 3–7 дней</p>
    </div>
  </div>

  <section class="section calc-section">
    <div class="container">
      <LedCalculator lang="ru" />
    </div>
  </section>

  <section class="section backlight-section">
    <div class="container">
      <div class="section-label">Подсветка</div>
      <h2>Типы подсветки</h2>
      <div class="backlight-grid">
        <div class="backlight-card">
          <div class="backlight-card__num">01</div>
          <h3>Фоновая подсветка</h3>
          <p>Светодиодная лента размещена за зеркалом — создаёт мягкое свечение вокруг и эффект глубины. Идеально для ванной комнаты и спальни. Освещение рассеянное, атмосферное.</p>
          <ul class="backlight-list">
            <li>◆ Мягкий атмосферный свет</li>
            <li>◆ Эффект «парящего» зеркала</li>
            <li>◆ Идеально для декора</li>
          </ul>
        </div>
        <div class="backlight-card">
          <div class="backlight-card__num">02</div>
          <h3>Фронтальная подсветка</h3>
          <p>Подсветка встроена в специальный канал по периметру лицевой стороны. Обеспечивает равномерное функциональное освещение для макияжа и бритья.</p>
          <ul class="backlight-list">
            <li>◆ Равномерное яркое освещение</li>
            <li>◆ Без теней на лице</li>
            <li>◆ Идеально для ванной / гардеробной</li>
          </ul>
        </div>
      </div>

      <div class="options-block">
        <div class="section-label" style="margin-top: 48px;">Дополнительные опции</div>
        <div class="options-grid">
          <div class="option-item">
            <span class="option-icon">▲</span>
            <div>
              <strong>Подогрев</strong>
              <p>Предотвращает запотевание зеркала (+400 грн)</p>
            </div>
          </div>
          <div class="option-item">
            <span class="option-icon">■</span>
            <div>
              <strong>Сенсор</strong>
              <p>Включение / выключение касанием (+300 грн)</p>
            </div>
          </div>
          <div class="option-item">
            <span class="option-icon">◆</span>
            <div>
              <strong>Диммер</strong>
              <p>Регулировка яркости подсветки (+200 грн)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section related-section">
    <div class="container">
      <a href="/ru/dzerkalo-u-vannu/" class="related-link">
        <span class="related-link__label">Популярное решение</span>
        <span class="related-link__title">Зеркало в ванную с подсветкой →</span>
        <span class="related-link__desc">Влагозащищённая подсветка, подогрев против запотевания, любая форма</span>
      </a>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container">
      <div class="section-label">Вопросы и ответы</div>
      <h2>О LED зеркалах</h2>
      <div class="faq">
        {faq.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero--dark { background: var(--bg); border-bottom: 1px solid var(--border); padding: 28px 0 24px; }
  .page-hero--dark .breadcrumb { color: var(--text-muted); margin-bottom: 10px; font-size: 0.82rem; display: flex; gap: 8px; align-items: center; }
  .page-hero--dark .breadcrumb a { color: var(--text-muted); }
  .page-hero--dark .section-label { margin-bottom: 4px; }
  .page-hero--dark h1 { font-size: clamp(1.35rem, 2.6vw, 1.9rem); color: var(--text); margin-bottom: 6px; }
  .hero-sub { color: var(--text-muted); font-size: 0.95rem; }
  .section-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold); margin-bottom: 8px; }
  .calc-section { background: var(--bg); padding: 28px 0 60px; }
  .backlight-section { background: #111; }
  .backlight-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 28px; }
  .backlight-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 32px; transition: border-color 0.2s; }
  .backlight-card:hover { border-color: rgba(201,168,76,0.3); }
  .backlight-card__num { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; color: var(--gold); margin-bottom: 12px; }
  .backlight-card h3 { color: var(--text); font-size: 1.15rem; margin-bottom: 12px; }
  .backlight-card p { color: var(--text-muted); font-size: 0.93rem; line-height: 1.7; margin-bottom: 20px; }
  .backlight-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .backlight-list li { color: var(--text-muted); font-size: 0.88rem; }
  .options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .option-item { display: flex; gap: 16px; align-items: flex-start; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 24px; transition: border-color 0.2s; }
  .option-item:hover { border-color: rgba(201,168,76,0.3); }
  .option-icon { color: var(--gold); font-size: 0.9rem; flex-shrink: 0; margin-top: 3px; }
  .option-item strong { display: block; color: var(--text); font-size: 0.95rem; margin-bottom: 4px; }
  .option-item p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; margin: 0; }
  .related-section { background: var(--bg); padding-top: 0; }
  .related-link { display: block; background: var(--bg-card); border: 1px solid var(--border); border-left: 3px solid var(--gold); border-radius: 12px; padding: 22px 26px; transition: border-color 0.2s; }
  .related-link:hover { border-color: rgba(201,168,76,0.5); }
  .related-link__label { display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--gold); margin-bottom: 6px; }
  .related-link__title { display: block; font-size: 1.15rem; color: var(--text); font-weight: 600; margin-bottom: 4px; }
  .related-link__desc { display: block; font-size: 0.9rem; color: var(--text-muted); }
  .faq-section { background: var(--bg); }
  .faq-section h2 { color: var(--text); }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 28px; }
  .faq-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 28px; transition: border-color 0.2s; }
  .faq-item:hover { border-color: rgba(201,168,76,0.3); }
  .faq-item h3 { margin-bottom: 10px; color: var(--gold); font-size: 1.05rem; }
  .faq-item p { font-size: 0.93rem; color: var(--text-muted); line-height: 1.7; margin: 0; }
  @media (max-width: 768px) { .backlight-grid { grid-template-columns: 1fr; } .options-grid { grid-template-columns: 1fr; } .faq { grid-template-columns: 1fr; } }
</style>
