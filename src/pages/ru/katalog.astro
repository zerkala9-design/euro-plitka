---
import Layout from '../../layouts/Layout.astro';

const products = [
  { img: '/panno-abstract.png', name: 'Милано',     desc: 'Асимметричные линии — современный акцент на всю стену.',              price: 'от 2 450 грн/м²' },
  { img: '/panno-chevron.png',  name: 'Верона',     desc: 'V-образный шеврон — динамичный геометрический дизайн.',            price: 'от 2 300 грн/м²' },
  { img: '/panno-geometry.png', name: 'Флоренция',  desc: 'Треугольные грани — стильное решение для минималистичных интерьеров.', price: 'от 2 450 грн/м²' },
  { img: '/panno-diagonal.png', name: 'Комо',       desc: 'Лаконичные диагонали — простор и чистота форм.',                 price: 'от 2 300 грн/м²' },
];

const faq = [
  { q: 'Можно ли заказать панно по своему размеру?', a: 'Да, каждое зеркальное панно изготавливается под размеры вашей стены. Выберите дизайн в каталоге и рассчитайте стоимость в калькуляторе под конкретные размеры.' },
  { q: 'Из каких цветов зеркала делают панно?', a: 'Серебро (классическое), бронза (тёплое золотистое) и графит (тёмное). Любой дизайн доступен во всех трёх цветах, с фацетом или без.' },
  { q: 'Можно ли сделать панно по собственному эскизу?', a: 'Да, кроме готовых дизайнов из каталога мы изготавливаем панно по вашему эскизу — любой узор и раскрой. Пришлите идею через форму контактов.' },
  { q: 'Сколько стоит зеркальное панно?', a: 'Стоимость зависит от дизайна, цвета, фацета и площади — от 2300 грн/м². Точную цену под ваши размеры мгновенно рассчитает калькулятор.' },
];
---

<Layout
  lang="ru"
  title="Каталог зеркальных панно — купить в Киеве"
  description="Каталог зеркальных панно на стену: асимметрия, шеврон, геометрия, диагонали. Изготовление под ваш размер, расчёт стоимости онлайн."
  breadcrumbs={[{ name: 'Главная', path: '/ru/' }, { name: 'Каталог', path: '/ru/katalog/' }]}
  faq={faq}
  product={{ name: 'Зеркальное панно на стену', lowPrice: 2300 }}
>
  <div class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/ru/">Главная</a><span>›</span><span>Каталог</span></div>
      <div class="section-label">Зеркальные панно</div>
      <h1>Каталог панно</h1>
      <p class="hero-sub">Выберите дизайн — и рассчитайте точную стоимость под размеры вашей стены</p>
      <p class="hero-sub" style="margin-top:10px;font-size:0.95rem"><a href="/ru/dzerkalne-panno-na-zamovlennya/" style="color:var(--gold);font-weight:600">Зеркальное панно на заказ — калькулятор цены →</a></p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="cat-grid">
        {products.map((p) => (
          <article class="cat-card">
            <div class="cat-card__media">
              <img src={p.img} alt={`Зеркальное панно — ${p.name}`} loading="lazy" />
            </div>
            <div class="cat-card__body">
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <div class="cat-card__foot">
                <span class="cat-card__price">{p.price}</span>
                <a href="/ru/dzerkalna-plitka/#calculator" class="btn btn--outline btn--sm">Рассчитать</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container">
      <div class="section-label">Вопросы и ответы</div>
      <h2>О зеркальных панно</h2>
      <div class="faq">
        {faq.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Нужен индивидуальный дизайн?</h2>
      <p>Сделаем панно по вашему эскизу — любой узор и размер</p>
      <div class="cta-banner__actions">
        <a href="/ru/kontakty/" class="btn btn--primary btn--lg">Связаться с нами</a>
        <a href="/ru/dzerkalna-plitka/#calculator" class="btn btn--ghost btn--lg">Калькулятор</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: var(--bg); border-bottom: 1px solid var(--border); padding: 60px 0 48px; }
  .breadcrumb { color: var(--text-muted); margin-bottom: 20px; font-size: 0.88rem; display: flex; gap: 8px; align-items: center; }
  .breadcrumb a:hover { color: var(--gold); }
  .page-hero h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); color: var(--text); margin-bottom: 12px; }
  .hero-sub { color: var(--text-muted); font-size: 1.1rem; max-width: 560px; }
  .section-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold); margin-bottom: 8px; }
  .cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .cat-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; box-shadow: var(--shadow); }
  .cat-card:hover { border-color: var(--gold-border); box-shadow: var(--shadow-md); transform: translateY(-4px); }
  .cat-card__media { aspect-ratio: 4 / 5; overflow: hidden; background: var(--bg-gray); }
  .cat-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
  .cat-card:hover .cat-card__media img { transform: scale(1.04); }
  .cat-card__body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .cat-card__body h3 { font-size: 1.15rem; color: var(--text); }
  .cat-card__body p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; flex: 1; margin: 0; }
  .cat-card__foot { margin-top: auto; padding-top: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .cat-card__price { font-size: 0.95rem; font-weight: 800; color: var(--gold); }
  .btn--sm { padding: 9px 16px; font-size: 0.8rem; }
  .cta-banner .btn--ghost { color: #fff; border-color: rgba(255,255,255,0.35); background: transparent; }
  .cta-banner .btn--ghost:hover { background: rgba(255,255,255,0.1); border-color: #fff; }
  .faq-section { background: var(--bg); }
  .faq-section h2 { color: var(--text); margin-bottom: 8px; }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  .faq-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 28px; transition: border-color 0.2s; }
  .faq-item:hover { border-color: rgba(201,168,76,0.3); }
  .faq-item h3 { margin-bottom: 10px; color: var(--gold); font-size: 1.05rem; }
  .faq-item p { font-size: 0.93rem; color: var(--text-muted); line-height: 1.7; margin: 0; }
  @media (max-width: 1000px) { .cat-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .faq { grid-template-columns: 1fr; } }
  @media (max-width: 460px) { .cat-grid { grid-template-columns: 1fr; } }
</style>
