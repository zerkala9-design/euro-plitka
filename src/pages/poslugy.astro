---
import Layout from '../layouts/Layout.astro';

const faq = [
  { q: 'Ви виготовляєте дзеркала за індивідуальними розмірами?', a: 'Так, усі вироби — дзеркальна плитка, панно та LED дзеркала — виготовляються під ваші розміри. Точний розкрій на ЧПУ дає мінімум відходів і акуратні краї.' },
  { q: 'Чи робите ви монтаж, чи тільки виготовлення?', a: 'Робимо повний цикл: виготовлення, доставка та монтаж під ключ. Досвідчена бригада встановить дзеркальну плитку або LED дзеркало по Києву та області. На виконані роботи діє гарантія.' },
  { q: 'Скільки часу займає виготовлення?', a: 'Дзеркальна плитка та панно — зазвичай 3–7 робочих днів, LED дзеркала — 3–7 днів залежно від опцій. Точний термін підтверджуємо при замовленні.' },
  { q: 'Куди доставляєте?', a: 'По Києву — власним транспортом, по всій Україні — Новою Поштою. Дзеркала пакуємо у захисний матеріал, що гарантує цілісність при перевезенні.' },
  { q: 'Як дізнатись вартість?', a: 'Найшвидше — через онлайн-калькулятори на сайті: для плитки/панно та для LED дзеркал. Введіть розміри й параметри — і побачите точну ціну одразу.' },
];

const breadcrumbs = [
  { name: 'Головна', path: '/' },
  { name: 'Послуги', path: '/poslugy/' },
];
---

<Layout
  title="Послуги — виготовлення та монтаж дзеркал у Києві"
  description="Виготовлення дзеркальної плитки, панно та LED дзеркал на замовлення. Монтаж під ключ, доставка по Києву та Україні. Гарантія на роботи."
  breadcrumbs={breadcrumbs}
  faq={faq}
>
  <div class="page-hero page-hero--dark">
    <div class="container">
      <div class="breadcrumb"><a href="/">Головна</a><span>›</span><span>Послуги</span></div>
      <div class="section-label">Що ми робимо</div>
      <h1>Наші послуги</h1>
      <p class="hero-sub">Виготовлення, монтаж та доставка дзеркальних виробів по Києву та Україні</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="services-list">
        <div class="service-card">
          <div class="service-card__num">01</div>
          <div class="service-card__body">
            <h2>Дзеркальна плитка з фацетом</h2>
            <p>Виготовляємо дзеркальну плитку у кольорах срібло, бронза, графіт з фацетом 0–20 мм. Точний розкрій на ЧПУ, мінімум відходів.</p>
            <a href="/dzerkalna-plitka" class="service-link">Калькулятор →</a>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card__num">02</div>
          <div class="service-card__body">
            <h2>Дзеркальні панно</h2>
            <p>Проектуємо та виготовляємо дзеркальні панно для стін будь-якого розміру. Індивідуальний підбір розкрою, 2 варіанти компоновки.</p>
            <a href="/" class="service-link">Відкрити калькулятор →</a>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card__num">03</div>
          <div class="service-card__body">
            <h2>LED дзеркала на замовлення</h2>
            <p>Виготовляємо LED дзеркала фонової та фронтальної підсвітки будь-яких розмірів. Опції: підігрів, сенсор, дімер. Виготовлення 3–7 днів.</p>
            <a href="/led-dzerkalo" class="service-link">Калькулятор LED →</a>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card__num">04</div>
          <div class="service-card__body">
            <h2>Монтаж та встановлення</h2>
            <p>Досвідчена бригада встановить дзеркальну плитку або LED дзеркало акуратно та швидко. Гарантія на виконані роботи.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card__num">05</div>
          <div class="service-card__body">
            <h2>Доставка по Києву та Україні</h2>
            <p>Доставляємо вироби у зручний для вас час власним транспортом або Новою Поштою. Акуратна упаковка гарантує цілісність дзеркал.</p>
            <a href="/dostavka" class="service-link">Умови доставки →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container">
      <div class="section-label">Запитання та відповіді</div>
      <h2>Часті запитання про послуги</h2>
      <div class="faq">
        {faq.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero--dark {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 60px 0 48px;
  }
  .page-hero--dark .breadcrumb { color: var(--text-muted); margin-bottom: 20px; font-size: 0.88rem; display: flex; gap: 8px; align-items: center; }
  .page-hero--dark .breadcrumb a { color: var(--text-muted); }
  .page-hero--dark h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); color: var(--text); margin-bottom: 12px; }
  .hero-sub { color: var(--text-muted); font-size: 1.1rem; }

  .section-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .services-list { display: flex; flex-direction: column; gap: 16px; }

  .service-card {
    display: flex;
    gap: 32px;
    align-items: flex-start;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    transition: border-color 0.2s;
  }
  .service-card:hover { border-color: rgba(201,168,76,0.3); }

  .service-card__num {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--gold);
    opacity: 0.4;
    line-height: 1;
    flex-shrink: 0;
    min-width: 52px;
    transition: opacity 0.2s;
  }
  .service-card:hover .service-card__num { opacity: 0.8; }

  .service-card__body h2 { font-size: 1.15rem; color: var(--text); margin-bottom: 10px; }
  .service-card__body p { color: var(--text-muted); font-size: 0.93rem; line-height: 1.7; margin: 0 0 14px; max-width: 65ch; }

  .service-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: opacity 0.2s;
  }
  .service-link:hover { opacity: 0.7; }

  .faq-section { background: var(--bg); }
  .faq-section h2 { color: var(--text); margin-bottom: 8px; }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  .faq-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 28px; transition: border-color 0.2s; }
  .faq-item:hover { border-color: rgba(201,168,76,0.3); }
  .faq-item h3 { margin-bottom: 10px; color: var(--gold); font-size: 1.05rem; }
  .faq-item p { font-size: 0.93rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  @media (max-width: 560px) {
    .service-card { flex-direction: column; gap: 12px; }
    .service-card__num { font-size: 1.6rem; }
    .faq { grid-template-columns: 1fr; }
  }
</style>
