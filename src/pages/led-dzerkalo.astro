---
import Layout from '../layouts/Layout.astro';
import LedCalculator from '../components/LedCalculator.astro';

const faq = [
  { q: 'Яка різниця між фоновою та фронтальною підсвіткою?', a: 'Фонова підсвітка розміщена за дзеркалом і створює м’яке атмосферне сяйво навколо (ефект «парящого» дзеркала). Фронтальна підсвітка вбудована по периметру лицьової сторони й дає рівномірне яскраве світло без тіней — ідеально для макіяжу та гоління.' },
  { q: 'Скільки коштує LED дзеркало на замовлення?', a: 'Ціна залежить від типу підсвітки, форми, розміру та додаткових опцій. Точну вартість миттєво порахує калькулятор на цій сторінці — оберіть параметри й побачите суму одразу.' },
  { q: 'Який колір підсвітки обрати?', a: 'Тепле світло 3000K — затишне, для спальні. Нейтральне 4000K — універсальне. Холодне 6000K — яскраве й функціональне, для ванної та гардеробної. Опційно доступний дімер для регулювання яскравості.' },
  { q: 'Чи можна зробити дзеркало за моїм розміром?', a: 'Так, усі LED дзеркала виготовляються за індивідуальними розмірами під ваше приміщення — прямокутні або круглі, із заокругленими кутами за бажанням.' },
  { q: 'Що таке підігрів і навіщо він?', a: 'Підігрів (+400 грн) — це нагрівальний елемент за дзеркалом, який запобігає запотіванню у ванній після душу. Дзеркало завжди залишається чистим і прозорим.' },
  { q: 'Скільки виготовляється LED дзеркало?', a: 'Виготовлення займає 3–7 робочих днів залежно від складності та опцій. Доставка по Києву та по всій Україні.' },
];

const breadcrumbs = [
  { name: 'Головна', path: '/' },
  { name: 'LED дзеркала', path: '/led-dzerkalo/' },
];
---

<Layout
  title="LED дзеркало з підсвіткою — калькулятор ціни, Київ"
  description="LED дзеркало з підсвіткою на замовлення: оберіть тип, розмір, колір світла, підігрів і сенсор — і побачте ціну одразу. Виготовлення 3-7 днів, доставка по Україні."
  breadcrumbs={breadcrumbs}
  faq={faq}
  product={{ name: 'LED дзеркало з підсвіткою', lowPrice: 3120 }}
>
  <div class="page-hero page-hero--dark">
    <div class="container">
      <div class="breadcrumb"><a href="/">Головна</a><span>›</span><span>LED дзеркала</span></div>
      <div class="section-label">Виготовлення на замовлення</div>
      <h1>Premium LED дзеркала на замовлення</h1>
      <p class="hero-sub">Фонова та фронтальна підсвітка · будь-які розміри · виготовлення 3–7 днів</p>
    </div>
  </div>

  <section class="section calc-section">
    <div class="container">
      <LedCalculator />
    </div>
  </section>

  <section class="section backlight-section">
    <div class="container">
      <div class="section-label">Підсвітка</div>
      <h2>Типи підсвітки</h2>
      <div class="backlight-grid">
        <div class="backlight-card">
          <div class="backlight-card__num">01</div>
          <h3>Фонова підсвітка</h3>
          <p>Світлодіодна стрічка розміщена за дзеркалом — створює м'яке сяйво навколо та ефект глибини. Ідеально для ванної кімнати та спальні. Освітлення розсіяне, атмосферне.</p>
          <ul class="backlight-list">
            <li>◆ М'яке атмосферне світло</li>
            <li>◆ Ефект "парящого" дзеркала</li>
            <li>◆ Ідеально для декору</li>
          </ul>
        </div>
        <div class="backlight-card">
          <div class="backlight-card__num">02</div>
          <h3>Фронтальна підсвітка</h3>
          <p>Підсвітка вбудована у спеціальний канал по периметру лицьової сторони. Забезпечує рівномірне функціональне освітлення для макіяжу та гоління.</p>
          <ul class="backlight-list">
            <li>◆ Рівномірне яскраве освітлення</li>
            <li>◆ Без тіней на обличчі</li>
            <li>◆ Ідеально для ванної / гардеробної</li>
          </ul>
        </div>
      </div>

      <div class="options-block">
        <div class="section-label" style="margin-top: 48px;">Додаткові опції</div>
        <div class="options-grid">
          <div class="option-item">
            <span class="option-icon">▲</span>
            <div>
              <strong>Підігрів</strong>
              <p>Запобігає запотіванню дзеркала (+400 грн)</p>
            </div>
          </div>
          <div class="option-item">
            <span class="option-icon">■</span>
            <div>
              <strong>Сенсор</strong>
              <p>Ввімкнення / вимкнення доторком (+300 грн)</p>
            </div>
          </div>
          <div class="option-item">
            <span class="option-icon">◆</span>
            <div>
              <strong>Дімер</strong>
              <p>Регулювання яскравості підсвітки (+200 грн)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section related-section">
    <div class="container">
      <a href="/dzerkalo-u-vannu/" class="related-link">
        <span class="related-link__label">Популярне рішення</span>
        <span class="related-link__title">Дзеркало у ванну з підсвіткою →</span>
        <span class="related-link__desc">Вологозахищена підсвітка, підігрів проти запотівання, будь-яка форма</span>
      </a>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container">
      <div class="section-label">Запитання та відповіді</div>
      <h2>Про LED дзеркала</h2>
      <div class="faq">
        {faq.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero--dark {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 28px 0 24px;
  }
  .page-hero--dark .breadcrumb { color: var(--text-muted); margin-bottom: 10px; font-size: 0.82rem; display: flex; gap: 8px; align-items: center; }
  .page-hero--dark .breadcrumb a { color: var(--text-muted); }
  .page-hero--dark .section-label { margin-bottom: 4px; }
  .page-hero--dark h1 { font-size: clamp(1.35rem, 2.6vw, 1.9rem); color: var(--text); margin-bottom: 6px; }
  .hero-sub { color: var(--text-muted); font-size: 0.95rem; }

  .section-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .calc-section { background: var(--bg); padding: 28px 0 60px; }
  .backlight-section { background: #111; }

  .backlight-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 28px; }
  .backlight-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    transition: border-color 0.2s;
  }
  .backlight-card:hover { border-color: rgba(201,168,76,0.3); }
  .backlight-card__num { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; color: var(--gold); margin-bottom: 12px; }
  .backlight-card h3 { color: var(--text); font-size: 1.15rem; margin-bottom: 12px; }
  .backlight-card p { color: var(--text-muted); font-size: 0.93rem; line-height: 1.7; margin-bottom: 20px; }
  .backlight-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .backlight-list li { color: var(--text-muted); font-size: 0.88rem; }

  .options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .option-item {
    display: flex; gap: 16px; align-items: flex-start;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 12px; padding: 24px;
    transition: border-color 0.2s;
  }
  .option-item:hover { border-color: rgba(201,168,76,0.3); }
  .option-icon { color: var(--gold); font-size: 0.9rem; flex-shrink: 0; margin-top: 3px; }
  .option-item strong { display: block; color: var(--text); font-size: 0.95rem; margin-bottom: 4px; }
  .option-item p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; margin: 0; }

  .related-section { background: var(--bg); padding-top: 0; }
  .related-link { display: block; background: var(--bg-card); border: 1px solid var(--border); border-left: 3px solid var(--gold); border-radius: 12px; padding: 22px 26px; transition: border-color 0.2s; }
  .related-link:hover { border-color: rgba(201,168,76,0.5); }
  .related-link__label { display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--gold); margin-bottom: 6px; }
  .related-link__title { display: block; font-size: 1.15rem; color: var(--text); font-weight: 600; margin-bottom: 4px; }
  .related-link__desc { display: block; font-size: 0.9rem; color: var(--text-muted); }

  .faq-section { background: var(--bg); }
  .faq-section h2 { color: var(--text); }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 28px; }
  .faq-item {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 12px; padding: 28px; transition: border-color 0.2s;
  }
  .faq-item:hover { border-color: rgba(201,168,76,0.3); }
  .faq-item h3 { margin-bottom: 10px; color: var(--gold); font-size: 1.05rem; }
  .faq-item p { font-size: 0.93rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  @media (max-width: 768px) {
    .backlight-grid { grid-template-columns: 1fr; }
    .options-grid { grid-template-columns: 1fr; }
    .faq { grid-template-columns: 1fr; }
  }
</style>
