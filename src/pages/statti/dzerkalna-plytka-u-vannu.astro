import ArticleLayout from '../../layouts/ArticleLayout.astro';

const faq = [
  { q: 'Чи можна клеїти дзеркальну плитку у ванній?', a: 'Так. Дзеркало добре переносить вологість, головне — кріпити його на нейтральний вологостійкий клей і забезпечити нормальну вентиляцію. Шви між плитками бажано обробити нейтральним герметиком, щоб волога не потрапляла під дзеркало.' },
  { q: 'Як позбутися запотівання дзеркала у ванній?', a: 'Найнадійніше рішення — LED дзеркало з підігрівом: нагрівальний елемент за дзеркалом тримає поверхню трохи теплішою за повітря, тож конденсат не осідає. Також допомагають хороша витяжка та фронтальна підсвітка.' },
  { q: 'Яке дзеркало безпечніше для ванної?', a: 'Для зон біля ванни й душу варто брати вироби з безпечного скла або з захисною плівкою на звороті: навіть при пошкодженні уламки утримуються й не розлітаються.' },
  { q: 'Який колір підсвітки обрати для ванної?', a: 'Холодне світло 6000K — яскраве й функціональне, добре для макіяжу та гоління. Нейтральне 4000K — універсальне й комфортне. Тепле 3000K — затишне, але менш контрастне для щоденних процедур.' },
];
---

<ArticleLayout
  slug="dzerkalna-plytka-u-vannu"
  description="Дзеркальна плитка та дзеркало у ванну: вологостійкість, підігрів проти запотівання, безпечне скло, підсвітка та догляд. Поради перед замовленням."
  faq={faq}
>
  <p class="lead">Ванна — найскладніше приміщення для дзеркала: постійна вологість, перепади температури й конденсат. Але з правильним підходом дзеркальна плитка та LED дзеркало служитимуть роками й виглядатимуть бездоганно. Ось що варто врахувати перед замовленням.</p>

  <h2>1. Вологостійкість і монтаж</h2>
  <p>Саме дзеркало вологи не боїться — уразливий його зворотний бік (амальгама). Тому у ванній важливо:</p>
  <ul>
    <li>кріпити плитку на <a href="/statti/chym-kleyity-dzerkalnu-plytku/">нейтральний вологостійкий клей</a>, а не кислотний силікон;</li>
    <li>обробити шви нейтральним герметиком, щоб волога не затікала під дзеркало;</li>
    <li>забезпечити робочу витяжку — застій вологого повітря шкодить будь-якому оздобленню.</li>
  </ul>

  <h2>2. Запотівання: як прибрати назавжди</h2>
  <p>Головний біль дзеркала у ванній — конденсат після душу. Рішення:</p>
  <ul>
    <li><strong>Підігрів дзеркала</strong> — нагрівальний елемент за поверхнею тримає її трохи теплішою за повітря, тож туман не осідає. Найнадійніший варіант.</li>
    <li><strong>Хороша вентиляція</strong> — витяжка швидко виводить вологе повітря.</li>
    <li><strong>Фронтальна підсвітка</strong> — трохи прогріває периметр і покращує видимість.</li>
  </ul>
  <div class="note"><p>Якщо запотівання дратує щоранку — беріть <a href="/dzerkalo-u-vannu/">LED дзеркало з підігрівом</a>. Це недорога опція, яка знімає проблему повністю.</p></div>

  <h2>3. Безпека скла</h2>
  <p>У зоні біля ванни, душу чи там, де бавляться діти, варто обрати вироби з безпечного скла або із захисною плівкою на звороті. При пошкодженні уламки утримуються плівкою й не розлітаються.</p>

  <h2>4. Підсвітка та колір світла</h2>
  <p>LED-підсвітка робить ванну функціональнішою та затишнішою:</p>
  <ul>
    <li><strong>6000K (холодне)</strong> — яскраве, контрастне світло для макіяжу й гоління.</li>
    <li><strong>4000K (нейтральне)</strong> — універсальний комфортний варіант.</li>
    <li><strong>3000K (тепле)</strong> — атмосферне, розслаблююче світло.</li>
  </ul>
  <p>Порахувати LED дзеркало з підсвіткою, підігрівом і сенсором можна в <a href="/led-dzerkalo/">калькуляторі LED дзеркал</a>.</p>

  <h2>5. Догляд</h2>
  <ul>
    <li>Протирайте м'якою тканиною або мікрофіброю.</li>
    <li>Уникайте абразивів і агресивної хімії біля країв — щоб не пошкодити кромку та амальгаму.</li>
    <li>Використовуйте засоби для скла без аміаку в надлишку.</li>
  </ul>

  <h2>Коротко</h2>
  <p>Для ванної: нейтральний вологостійкий клей, оброблені шви, підігрів проти запотівання, безпечне скло й підходяща підсвітка. Тоді дзеркало залишатиметься чистим і прозорим роками.</p>
</ArticleLayout>
