---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Crumb { name: string; path: string; }
interface Faq { q: string; a: string; }
interface Article { headline: string; datePublished: string; dateModified?: string; }
interface Product { name: string; lowPrice: number; unit?: string; }
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbs?: Crumb[];
  faq?: Faq[];
  article?: Article;
  product?: Product;
}

const {
  title,
  description = 'Дзеркальна плитка та LED дзеркала в Києві. Виготовлення панно, монтаж, доставка. Онлайн-калькулятор.',
  canonical,
  ogImage = '/hero-on.jpg',
  breadcrumbs,
  faq,
  article,
  product,
} = Astro.props;

const origin = 'https://euro-plitka.com.ua';
const url = canonical ?? `${origin}${Astro.url.pathname}`;
const ogImageUrl = `${origin}${ogImage}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  image: ogImageUrl,
  url: origin,
  telephone: [site.phone.tel, site.phone2?.tel].filter(Boolean),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'вул. Вадима Гетьмана, 27',
    addressLocality: 'Київ',
    addressCountry: 'UA',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '10:00',
    closes: '18:00',
  },
  description: 'Виробник дзеркальної плитки, дзеркальних панно та LED дзеркал у Києві. Виготовлення на замовлення, монтаж під ключ, доставка по Україні.',
  priceRange: '₴₴',
  areaServed: ['Київ', 'Київська область', 'Україна'],
  sameAs: [site.social.instagram, site.social.telegram].filter(Boolean),
};

const breadcrumbLd = breadcrumbs && breadcrumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: `${origin}${c.path}`,
  })),
} : null;

const articleLd = article ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.headline,
  description,
  image: ogImageUrl,
  datePublished: article.datePublished,
  dateModified: article.dateModified ?? article.datePublished,
  author: { '@type': 'Organization', name: site.name, url: origin },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: `${origin}/apple-touch-icon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
} : null;

const productLd = product ? {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: ogImageUrl,
  description,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'UAH',
    lowPrice: product.lowPrice,
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: site.name },
  },
} : null;

const faqLd = faq && faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---

<!doctype html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Євро Плитка</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#b89244" />
  <meta name="w3f-key" content={site.formAccessKey} />
  <link rel="canonical" href={url} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
  <meta property="og:title" content={`${title} | Євро Плитка`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="uk_UA" />
  <meta property="og:site_name" content="Євро Плитка" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Євро Плитка`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
  {productLd && <script type="application/ld+json" set:html={JSON.stringify(productLd)} />}
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
