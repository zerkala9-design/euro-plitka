  .calc-title { margin-bottom: 6px; color: var(--text); font-family: var(--font-heading); }
  .calc-sub { color: var(--text-muted); margin-bottom: 28px; }

  .calc-inputs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .calc-field {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px 14px;
    cursor: pointer;
    transition: border-color 0.2s;
    min-width: 160px;
    flex: 1;
  }
  .calc-field:focus-within { border-color: var(--gold); }
  .calc-field__label { font-size: 0.95rem; font-weight: 600; color: var(--text-mid); white-space: nowrap; }
  .calc-field input, .calc-field select {
    flex: 1;
    border: none;
    outline: none;
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 600;
    background: transparent;
    color: var(--text);
    min-width: 50px;
  }
  .calc-field select option { background: var(--white); color: var(--text); }
  .calc-field__unit { font-size: 0.8rem; color: var(--text-muted); }
  .calc-field__swatch {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 1px solid #444;
    flex-shrink: 0;
  }

  .calc-panels {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px;
  }

  .calc-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
  }

  .panel-header {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 8px;
  }
  .panel-mode { font-size: 0.85rem; color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }

  .panel-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: visible;
  }
  .panel-svg { display: block; max-width: 100%; height: auto; }

  .panel-zoom {
    display: flex;
    gap: 8px;
    justify-content: center;
  }
  .zoom-btn {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 6px;
    width: 34px; height: 34px;
    font-size: 1.1rem;
    cursor: pointer;
    color: var(--gold);
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s;
  }
  .zoom-btn:hover:not(:disabled) { border-color: var(--gold); background: var(--gold-pale); }
  .zoom-btn:disabled { opacity: 0.35; cursor: default; }

  .panel-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.95rem;
    color: var(--text-mid);
  }
  .panel-info b { color: var(--text); font-weight: 700; }

  .panel-price {
    margin-top: -6px;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
  }
  .panel-price .price-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-mid);
  }
  .panel-price .price-total {
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--gold);
  }

  .panel-order { margin-top: auto; width: 100%; }

  /* Модалка */
  .order-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.65);
    z-index: 1000;
    padding: 20px;
    overflow-y: auto;
    align-items: center;
    justify-content: center;
  }
  .order-modal.open { display: flex; }
  .order-modal__box {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    max-width: 600px;
    width: 100%;
    position: relative;
    box-shadow: var(--shadow-lg);
  }
  .order-modal__close {
    position: absolute; top: 14px; right: 14px;
    background: none; border: none; font-size: 1.2rem;
    cursor: pointer; color: #999; width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
  }
  .order-modal__close:hover { background: var(--bg-gray); color: var(--text); }
  .order-modal__box h3 { margin-bottom: 18px; color: var(--text); }

