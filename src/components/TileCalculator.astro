---
import { tileCalcConfig } from '../data/site';
const cfg = JSON.stringify(tileCalcConfig);
const { lang = 'uk' } = Astro.props;
const DICT = {
  uk: {
    calcTitle: 'Калькулятор дзеркального панно',
    calcSub: 'Введіть розміри вашої стіни — отримайте варіанти розкрою та вартість',
    width: 'Ширина', height: 'Висота', facet: 'Фацет', color: 'Колір',
    colSilver: 'Срібло', colBronze: 'Бронза', colGraphite: 'Графіт',
    cutMode: 'Розкрій квадратами', fitMode: 'Розкрій ромбами',
    reset: 'Скинути', zoomIn: 'Збільшити плитку', zoomOut: 'Зменшити плитку',
    order: '🛒 Замовити', modalPanno: 'Дзеркальне панно',
    phName: "Ім'я та Прізвище", phPhone: 'Телефон', send: 'Відправити замовлення',
    locale: 'uk-UA', currency: 'грн', mm: 'мм', pcs: 'шт.',
    colorNames: ['', 'срібло', 'бронза', 'графіт'],
    panelSize: 'Розмір панно:', adjusted: '(підігнано під розкрій)',
    tile: 'Плитка:', diagonals: 'Діагоналі:', grid: 'Сітка:', priceLbl: 'Ціна:',
    cutName: 'квадрати', fitName: 'ромби', diagRhomb: 'Діагональ ромба:',
    thForm: 'Форма', thSize: 'Розмір', thFacet: 'Фацет', thColor: 'Колір', thQty: 'К-во', thPrice: 'Ціна', totalLbl: 'Всього',
    fSquare: 'квадрат', fRhomb: 'ромб', triangle: 'трикутник',
    alertNamePhone: "Будь ласка, вкажіть ім'я та телефон",
    alertNoForm: 'Форму ще не підключено до пошти. Зверніться, будь ласка, у Telegram або за телефоном.',
    sending: 'Відправляємо…', subject: 'Заявка з сайту — дзеркальна плитка',
    fName: "Ім'я", fPhone: 'Телефон', fPanno: 'Панно', fCut: 'Розкрій',
    success: "Дякуємо! Заявку відправлено. Ми зв'яжемося з вами найближчим часом.",
    failSend: 'Не вдалося відправити. Спробуйте ще раз або напишіть у Telegram.',
    failNet: 'Помилка мережі. Перевірте інтернет і спробуйте ще раз.',
  },
  ru: {
    calcTitle: 'Калькулятор зеркального панно',
    calcSub: 'Введите размеры вашей стены — получите варианты раскроя и стоимость',
    width: 'Ширина', height: 'Высота', facet: 'Фацет', color: 'Цвет',
    colSilver: 'Серебро', colBronze: 'Бронза', colGraphite: 'Графит',
    cutMode: 'Раскрой квадратами', fitMode: 'Раскрой ромбами',
    reset: 'Сбросить', zoomIn: 'Увеличить плитку', zoomOut: 'Уменьшить плитку',
    order: '🛒 Заказать', modalPanno: 'Зеркальное панно',
    phName: 'Имя и Фамилия', phPhone: 'Телефон', send: 'Отправить заказ',
    locale: 'ru-RU', currency: 'грн', mm: 'мм', pcs: 'шт.',
    colorNames: ['', 'серебро', 'бронза', 'графит'],
    panelSize: 'Размер панно:', adjusted: '(подогнано под раскрой)',
    tile: 'Плитка:', diagonals: 'Диагонали:', grid: 'Сетка:', priceLbl: 'Цена:',
    cutName: 'квадраты', fitName: 'ромбы', diagRhomb: 'Диагональ ромба:',
    thForm: 'Форма', thSize: 'Размер', thFacet: 'Фацет', thColor: 'Цвет', thQty: 'Кол-во', thPrice: 'Цена', totalLbl: 'Всего',
    fSquare: 'квадрат', fRhomb: 'ромб', triangle: 'треугольник',
    alertNamePhone: 'Пожалуйста, укажите имя и телефон',
    alertNoForm: 'Форма ещё не подключена к почте. Свяжитесь, пожалуйста, в Telegram или по телефону.',
    sending: 'Отправляем…', subject: 'Заявка с сайта — зеркальная плитка',
    fName: 'Имя', fPhone: 'Телефон', fPanno: 'Панно', fCut: 'Раскрой',
    success: 'Спасибо! Заявка отправлена. Мы свяжемся с вами в ближайшее время.',
    failSend: 'Не удалось отправить. Попробуйте ещё раз или напишите в Telegram.',
    failNet: 'Ошибка сети. Проверьте интернет и попробуйте ещё раз.',
  },
};
const T = DICT[lang] || DICT.uk;
const tJson = JSON.stringify(T);
---

<section class="calc-section section">
  <div class="container">
    <h2 class="calc-title">{T.calcTitle}</h2>
    <p class="calc-sub">{T.calcSub}</p>

    <div class="calc-inputs">
      <label class="calc-field">
        <span class="calc-field__label">{T.width}</span>
        <input type="number" id="wallW" value="1500" min="300" max="5000" step="10" />
        <span class="calc-field__unit">{T.mm}</span>
      </label>
      <label class="calc-field">
        <span class="calc-field__label">{T.height}</span>
        <input type="number" id="wallH" value="2700" min="300" max="5000" step="10" />
        <span class="calc-field__unit">{T.mm}</span>
      </label>
      <label class="calc-field">
        <span class="calc-field__label">{T.facet}</span>
        <select id="facet">
          <option value="1">0 мм</option>
          <option value="2">5 мм</option>
          <option value="3" selected>10 мм</option>
          <option value="4">15 мм</option>
          <option value="5">20 мм</option>
        </select>
      </label>
      <label class="calc-field calc-field--color">
        <span class="calc-field__label">{T.color}</span>
        <select id="color">
          <option value="1">{T.colSilver}</option>
          <option value="2">{T.colBronze}</option>
          <option value="3">{T.colGraphite}</option>
        </select>
        <span class="calc-field__swatch" id="colorSwatch"></span>
      </label>
    </div>

    <div class="calc-panels" id="calcPanels">
      <!-- cut -->
      <div class="calc-panel" id="panel-cut">
        <div class="panel-header">
          <span class="panel-mode">{T.cutMode}</span>
        </div>
        <div class="panel-preview">
          <svg class="panel-svg" id="svg-cut" xmlns="http://www.w3.org/2000/svg"></svg>
          <div class="panel-cutted" id="cutted-cut"></div>
        </div>
        <div class="panel-zoom">
          <button class="zoom-btn" id="reset-cut" title={T.reset}>↺</button>
          <button class="zoom-btn" id="zoom-in-cut" title={T.zoomIn}>−</button>
          <button class="zoom-btn" id="zoom-out-cut" title={T.zoomOut}>+</button>
        </div>
        <div class="panel-info" id="info-cut"></div>
        <div class="panel-price" id="price-cut"></div>
        <button class="btn btn--primary panel-order" data-mode="cut">{T.order}</button>
      </div>

      <!-- fit -->
      <div class="calc-panel" id="panel-fit">
        <div class="panel-header">
          <span class="panel-mode">{T.fitMode}</span>
        </div>
        <div class="panel-preview">
          <svg class="panel-svg" id="svg-fit" xmlns="http://www.w3.org/2000/svg"></svg>
        </div>
        <div class="panel-zoom">
          <button class="zoom-btn" id="reset-fit" title={T.reset}>↺</button>
          <button class="zoom-btn" id="zoom-in-fit" title={T.zoomIn}>−</button>
          <button class="zoom-btn" id="zoom-out-fit" title={T.zoomOut}>+</button>
        </div>
        <div class="panel-info" id="info-fit"></div>
        <div class="panel-price" id="price-fit"></div>
        <button class="btn btn--primary panel-order" data-mode="fit">{T.order}</button>
      </div>
    </div>

    <!-- Модалка замовлення -->
    <div class="order-modal" id="orderModal">
      <div class="order-modal__box">
        <button class="order-modal__close" id="closeModal">✕</button>
        <h3 id="modalTitle">{T.modalPanno}</h3>
        <div class="order-diag" id="orderDiag"></div>
        <table class="order-table" id="orderTable"></table>
        <div class="order-modal__form">
          <input type="text" placeholder={T.phName} class="order-modal__input" id="modalName" />
          <input type="tel" placeholder={T.phPhone} class="order-modal__input" id="modalPhone" />
          <button class="btn btn--primary" id="submitOrder" style="width:100%">{T.send}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ cfg, tJson }}>
const CFG = JSON.parse(cfg);
const T = JSON.parse(tJson);
const MODES = ['cut', 'fit'];
const customCols = { cut: 0, fit: 0 };
const panelData = {};

// Кольори превʼю панно за кольором дзеркала (як в оригіналі)
const TILE_THEME = {
  1: { c1: '#eef3f7', c2: '#cbd4dc', c3: '#ffffff', line: '#96a1a9' }, // Срібло
  2: { c1: '#f0dea4', c2: '#caa049', c3: '#fdf6dd', line: '#9c761a' }, // Бронза
  3: { c1: '#d3d9dd', c2: '#868d93', c3: '#f1f4f6', line: '#565c61' }, // Графіт
};

// --- Ціна (з app.js) ---
function areaPrice(color) {
  return Number(color) === 1 ? CFG.silverPrice : CFG.colorPrice;
}

function facetPrice(facet) {
  return CFG.facetsPrices[Number(facet) - 1] || 0;
}

function calcPrice(row) {
  const w = row.width, h = row.height, qty = row.quantity;
  let form = row.form;
  if (row.triangle) form *= CFG.trianglePrice;
  const ap = areaPrice(row.color);
  const fp = facetPrice(row.facet);
  return Math.round((w * h * 1e-6 * ap + (2 * w + 2 * h) * 0.001 * fp) * form * qty * CFG.defaultPrice * CFG.extraPrice);
}

// --- Осі (з app.js) ---
function calcAxisX(input, customC) {
  const X = {};
  X.size = Number((input.width / 10).toFixed(2));
  X.grid = Math.round(X.size / (CFG.gridAuto / 10)) + customC;
  X.tile = X.size / X.grid;
  return X;
}

function calcAxisY(input) {
  const Y = {};
  Y.size = Number((input.height / 10).toFixed(2));
  Y.grid = Math.round(Y.size / (CFG.gridAuto / 10));
  Y.tile = Y.size / Y.grid;
  return Y;
}

// --- Генерація панелі (з app.js generatePanel) ---
function generatePanel(mode, input, customC) {
  const X = calcAxisX(input, customC);
  const Y = calcAxisY(input);

  if (mode === 'fit') {
    X.tile = X.size / X.grid;
    Y.tile = Y.size / Y.grid;
    const ratio = Y.tile / X.tile;
    if (ratio < CFG.gridRatio.ideal || ratio > CFG.gridRatio.max) {
      Y.tile = X.tile * CFG.gridRatio.ideal;
      Y.grid = Y.size / Y.tile;
      Y.tile = Y.size / Math.ceil(Y.grid);
    }
  }

  if (mode === 'cover') {
    X.tile = Y.tile = X.size / X.grid;
    Y.grid = Math.floor(Y.size / X.tile);
    Y.covered = Y.size - X.tile * Y.grid;
  }

  if (mode === 'cut') {
    // Квадрати: тримаємо ДІАГОНАЛЬ круглою і підганяємо РОЗМІР панно
    // під ціле число діагоналей по обох сторонах.
    // 1) базова діагональ від ширини та зуму, округлена до кроку 25 мм (2.5 см)
    const d0 = X.size / X.grid;              // см
    let D = Math.round(d0 / 2.5) * 2.5;      // округлення діагоналі до 25 мм
    if (D < 20) D = 20;                       // не менше 200 мм
    // 2) ціле число діагоналей по кожній стороні
    const colsN = Math.max(1, Math.round(X.size / D));
    const rowsN = Math.max(1, Math.round(Y.size / D));
    X.sizeO = X.size; Y.sizeO = Y.size;       // введені розміри (для довідки)
    X.tile = Y.tile = D;
    X.grid = colsN; Y.grid = rowsN;
    X.size = colsN * D;                        // підігнана ширина (см)
    Y.size = rowsN * D;                        // підігнана висота (см)
    X.adjusted = Math.abs(X.size - X.sizeO) > 0.001;
    Y.adjusted = Math.abs(Y.size - Y.sizeO) > 0.001;
  }

  return { mode, input, X, Y };
}

// --- Генерація рядків (з app.js generateRows) ---
function generateRows(panel) {
  const { X, Y } = panel;
  const d1 = 10 * X.tile; // діагональ X у мм
  const d2 = 10 * Y.tile; // діагональ Y у мм
  const tileSide = Math.sqrt((d1 / 2) ** 2 + (d2 / 2) ** 2); // сторона ромба у мм

  const cols = Math.round(X.size / X.tile);
  const rowCount = Math.round(Y.size / Y.tile);
  const r = Y.size / Y.tile;

  let c = (cols - 1) * rowCount + (rowCount - 1) * cols; // цілі плитки
  let u = 2 * (cols + rowCount);                          // крайові трикутники
  let d = 0, p = 0, m = 0;

  if (panel.mode === 'cover' && r > rowCount) {
    const v = Number((r - rowCount).toFixed(2));
    if (v < 0.5) c += cols;
  }

  if (panel.mode === 'cut') {
    const h = Math.round(10 * r) / 10;
    if (rowCount - h > 0) { c -= cols - 1; u -= 3; m = 2; }
  }

  const f = (Math.abs(X.tile - Y.tile) < 0.001) ? 1 : 1.3;

  if (panel.mode === 'fit' && Math.abs(X.tile - Y.tile) >= 0.001) {
    u = 0;
    d = 2 * cols;
    p = 2 * rowCount;
  }

  const colorVal = Number(panel.input.color);
  const facetVal = Number(panel.input.facet);
  const rows = [];

  function addRow(qty, isTri, wP, hP, form) {
    if (!qty) return;
    // width/height (округлені) — для розрахунку ціни; wLabel/hLabel — точні (до сотих) для показу
    const row = { form, triangle: isTri, width: Math.round(wP), height: Math.round(hP), wLabel: wP, hLabel: hP, facet: facetVal, color: colorVal, quantity: qty };
    row.price = calcPrice(row);
    rows.push(row);
  }

  const sw = Math.round(tileSide);
  const halfSideP = d1 / 2;

  addRow(c, false, tileSide, tileSide, f);
  addRow(u, true,  tileSide, tileSide, f);
  addRow(d, true,  tileSide, tileSide, f);
  addRow(p, true,  tileSide, tileSide, f);
  addRow(m, true,  halfSideP, halfSideP, f);

  let total = rows.reduce((s, r) => s + r.price, 0);

  // Ціна = матеріал (за площею) + фацет (за периметром усіх плиток).
  // Чим менші плитки — тим більший сумарний периметр фацета → дорожче.
  //   Матеріал, грн/м²: Срібло 3000/3600, Бронза/Графіт 4200/4800 (квадрати/ромби).
  //   Фацет, грн/м: [0, 35, 55, 75, 95] для 0/5/10/15/20 мм.
  {
    const RATES = {
      1: { cut: 3000, fit: 3600 }, // срібло
      2: { cut: 4200, fit: 4800 }, // бронза
      3: { cut: 4200, fit: 4800 }, // графіт
    };
    const r = RATES[Number(panel.input.color)] || RATES[1];
    const areaM2 = (X.size / 100) * (Y.size / 100);
    const rate = panel.mode === 'fit' ? r.fit : r.cut;
    const fp = CFG.facetsPrices[Number(panel.input.facet) - 1] || 0; // грн за 1 м фацета
    let facetMeters = 0;
    for (const row of rows) facetMeters += row.quantity * 2 * (row.width + row.height) / 1000;
    total = Math.round((areaM2 * rate + facetMeters * fp) * 0.85); // −15% до підсумкової ціни
  }

  return {
    rows,
    total,
    tileSize: sw,
    tileSizePrecise: tileSide,
    d1: d1,
    d2: d2,
    cols,
    rowCount,
    isSquare: f === 1,
    panelW: Math.round(X.size * 10),   // фактична ширина панно, мм
    panelH: Math.round(Y.size * 10),   // фактична висота панно, мм
    adjusted: !!(X.adjusted || Y.adjusted),
  };
}

// --- SVG малювання (діагональна сітка, як в оригіналі) ---
function drawPanel(mode, panel, info) {
  const svgEl = document.getElementById('svg-' + mode);
  const { X, Y } = panel;

  const MAX_W = 380, MAX_H = 360;
  const ratio = Y.size / X.size;
  let dW, dH;
  if (ratio > MAX_H / MAX_W) {
    dH = MAX_H; dW = dH / ratio;
  } else {
    dW = MAX_W; dH = dW * ratio;
  }
  dW = Math.round(dW); dH = Math.round(dH);

  const MARGIN_TOP = 30, MARGIN_RIGHT = 34, MARGIN_LEFT = 34;
  const VW = MARGIN_LEFT + dW + MARGIN_RIGHT;
  const VH = dH + MARGIN_TOP + 4;

  svgEl.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
  svgEl.style.width = VW + 'px';
  svgEl.style.height = VH + 'px';

  const ox = MARGIN_LEFT, oy = MARGIN_TOP;
  const scaleX = dW / X.size;
  const scaleY = dH / Y.size;
  const tW = X.tile * scaleX;
  const tH = Y.tile * scaleY;

  // Кожна плитка — окреме плоске дзеркало з фацетом по всьому контуру.
  // Ромб обрізається по краю панелі → повний ромб / трикутник / пʼятикутник,
  // і фаска йде по ВСІХ його сторонах (включно з прямим краєм біля периметра).
  const cols = Math.ceil(X.size / X.tile) + 1;
  const rows = Math.ceil(Y.size / Y.tile) + 1;
  const hx = tW / 2, hy = tH / 2;
  const theme = TILE_THEME[Number(panel.input.color)] || TILE_THEME[1];
  const facetMM = [0, 0, 5, 10, 15, 20][Number(panel.input.facet)] || 10;
  const baseD = Math.min(hx, hy) * Math.min(0.22, 0.03 + facetMM * 0.008); // глибина фаски (px), більший фацет → ширша

  const oL = ox, oT = oy, oR = ox + dW, oB = oy + dH;
  const lightX = -0.7071, lightY = -0.7071; // світло згори-зліва

  // Обрізка опуклого багатокутника прямокутником [oL,oT,oR,oB]
  function clipHalf(poly, keep, isX, val) {
    const out = [];
    for (let i = 0; i < poly.length; i++) {
      const a = poly[i], b = poly[(i + 1) % poly.length];
      const ain = keep(a), bin = keep(b);
      if (ain) out.push(a);
      if (ain !== bin) {
        const t = isX ? (val - a[0]) / (b[0] - a[0]) : (val - a[1]) / (b[1] - a[1]);
        out.push([a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])]);
      }
    }
    return out;
  }
  function clipRect(poly) {
    let p = poly;
    p = clipHalf(p, v => v[0] >= oL, true, oL);  if (p.length < 3) return p;
    p = clipHalf(p, v => v[0] <= oR, true, oR);  if (p.length < 3) return p;
    p = clipHalf(p, v => v[1] >= oT, false, oT); if (p.length < 3) return p;
    p = clipHalf(p, v => v[1] <= oB, false, oB); return p;
  }
  // прибрати дублі та колінеарні точки (клип по вершині створює нульові сторони → NaN нормалі)
  function cleanPoly(poly) {
    const out = [];
    for (let i = 0; i < poly.length; i++) {
      const a = poly[i];
      const b = out.length ? out[out.length - 1] : poly[poly.length - 1];
      if (Math.hypot(a[0] - b[0], a[1] - b[1]) > 0.4) out.push(a);
    }
    // замкнутість: перша й остання не збігаються
    while (out.length > 1 && Math.hypot(out[0][0] - out[out.length - 1][0], out[0][1] - out[out.length - 1][1]) < 0.4) out.pop();
    // прибрати майже колінеарні вершини
    const res = [];
    const m = out.length;
    for (let i = 0; i < m; i++) {
      const prev = out[(i - 1 + m) % m], cur = out[i], next = out[(i + 1) % m];
      const v1x = cur[0] - prev[0], v1y = cur[1] - prev[1];
      const v2x = next[0] - cur[0], v2y = next[1] - cur[1];
      const cross = v1x * v2y - v1y * v2x;
      const l1 = Math.hypot(v1x, v1y), l2 = Math.hypot(v2x, v2y);
      if (Math.abs(cross) > 0.5 * l1 * l2 * 0.02) res.push(cur); // не колінеарна
    }
    return res.length >= 3 ? res : out;
  }

  const fnum = n => n.toFixed(1);
  const ptsStr = pl => pl.map(v => `${fnum(v[0])},${fnum(v[1])}`).join(' ');

  let facets = '';  // затінені грані фацета (обʼємний скіс)
  let edges = '';   // контур плитки + межа плоскої частини

  for (let q = -1; q <= 2 * rows + 1; q++) {
    for (let p = -1; p <= 2 * cols + 1; p++) {
      if (((p + q) & 1) === 0) continue; // ромби на непарних вузлах → цілі трикутники в кутах
      const cx = ox + p * hx, cy = oy + q * hy;
      const diamond = [[cx, cy - hy], [cx + hx, cy], [cx, cy + hy], [cx - hx, cy]];
      const poly = cleanPoly(clipRect(diamond));
      const n = poly.length;
      if (n < 3) continue;

      // центроїд
      let gx = 0, gy = 0;
      for (const v of poly) { gx += v[0]; gy += v[1]; }
      gx /= n; gy /= n;

      // безпечна глибина фаски: не більша за 0.8 відстані центроїда до найближчої сторони
      let minDist = Infinity;
      const norm = [];
      for (let i = 0; i < n; i++) {
        const a = poly[i], b = poly[(i + 1) % n];
        let ex = b[0] - a[0], ey = b[1] - a[1];
        const len = Math.hypot(ex, ey) || 1; ex /= len; ey /= len;
        let nx = -ey, ny = ex;                       // нормаль
        if ((gx - a[0]) * nx + (gy - a[1]) * ny < 0) { nx = -nx; ny = -ny; } // всередину
        norm.push([nx, ny, ex, ey]);
        const dist = (gx - a[0]) * nx + (gy - a[1]) * ny;
        if (dist < minDist) minDist = dist;
      }
      const d = Math.min(baseD, minDist * 0.92);
      if (d < 0.6) continue; // занадто дрібно — пропускаємо

      // внутрішній контур (зсув кожної сторони всередину на d, перетин сусідніх)
      const inner = [];
      for (let i = 0; i < n; i++) {
        const [nx0, ny0, ex0, ey0] = norm[(i - 1 + n) % n];
        const [nx1, ny1, ex1, ey1] = norm[i];
        const a0 = poly[(i - 1 + n) % n], a1 = poly[i];
        const P0 = [a0[0] + nx0 * d, a0[1] + ny0 * d];
        const P1 = [a1[0] + nx1 * d, a1[1] + ny1 * d];
        const denom = ex0 * ey1 - ey0 * ex1;
        if (Math.abs(denom) < 1e-6) { inner.push(P1); continue; }
        const t = ((P1[0] - P0[0]) * ey1 - (P1[1] - P0[1]) * ex1) / denom;
        inner.push([P0[0] + ex0 * t, P0[1] + ey0 * t]);
      }

      // Обʼємна світлотінь граней фацета: грань до світла — світла, від світла — темніша.
      for (let i = 0; i < n; i++) {
        const a = poly[i], b = poly[(i + 1) % n];
        const ia = inner[i], ib = inner[(i + 1) % n];
        const [nx, ny] = norm[i];
        const shade = -(nx * lightX + ny * lightY); // грань дивиться назовні (−нормаль)
        const col = shade >= 0 ? '#ffffff' : '#000000';
        const op = (shade >= 0
          ? Math.min(0.55, shade * 0.42 + 0.10)
          : Math.min(0.30, -shade * 0.24 + 0.05)).toFixed(3);
        facets += `<polygon points="${fnum(a[0])},${fnum(a[1])} ${fnum(b[0])},${fnum(b[1])} ${fnum(ib[0])},${fnum(ib[1])} ${fnum(ia[0])},${fnum(ia[1])}" fill="${col}" fill-opacity="${op}"/>`;
      }
      // кутові лінії-стики фацета: зовнішній кут → внутрішній кут (як на малюнку)
      for (let i = 0; i < n; i++) {
        const a = poly[i], ia = inner[i];
        edges += `<line x1="${fnum(a[0])}" y1="${fnum(a[1])}" x2="${fnum(ia[0])}" y2="${fnum(ia[1])}" stroke="${theme.line}" stroke-width="0.9" stroke-opacity="0.75"/>`;
      }
      // Тонкий шов між плитками
      edges += `<polygon points="${ptsStr(poly)}" fill="none" stroke="${theme.line}" stroke-width="0.7" stroke-opacity="0.8"/>`;
      // Лінія-складка фаски (межа плоскої частини): сіра + білий блік — чіткіша
      edges += `<polygon points="${ptsStr(inner)}" fill="none" stroke="${theme.line}" stroke-width="1.1" stroke-opacity="0.85"/>`;
      edges += `<g transform="translate(-0.6,-0.6)"><polygon points="${ptsStr(inner)}" fill="none" stroke="#ffffff" stroke-width="0.8" stroke-opacity="0.8"/></g>`;
    }
  }

  const clipId = 'cl-' + mode;
  const gradId = 'gr-' + mode;
  const fs = 13;
  const dimColor = '#9a7420';

  // Cutted (cut-режим): смуга знизу яка відрізається
  let cuttedRect = '';
  if (mode === 'cut' && Y.cutted) {
    const cutPx = Y.cutted * scaleY;
    cuttedRect = `<rect x="${ox}" y="${oy + dH}" width="${dW}" height="${cutPx.toFixed(1)}" fill="rgba(80,80,80,0.22)" stroke="#888" stroke-width="0.8"/>`;
  }


  svgEl.innerHTML = `
    <defs>
      <clipPath id="${clipId}">
        <rect x="${ox}" y="${oy}" width="${dW}" height="${dH}" />
      </clipPath>
    </defs>
    <!-- рівний однорідний колір дзеркала (без переливу) -->
    <rect x="${ox}" y="${oy}" width="${dW}" height="${dH}" fill="${theme.c1}"/>
    <!-- фацети кожного ромба: обʼємні скошені грані -->
    <g clip-path="url(#${clipId})">${facets}</g>
    <!-- контури: шов між ромбами + межа плоскої частини -->
    <g clip-path="url(#${clipId})">${edges}</g>
    ${cuttedRect}
    <rect x="${ox}" y="${oy}" width="${dW}" height="${dH}" fill="none" stroke="${theme.line}" stroke-width="2"/>
    <rect x="${(ox+1).toFixed(1)}" y="${(oy+1).toFixed(1)}" width="${(dW-2).toFixed(1)}" height="${(dH-2).toFixed(1)}" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1"/>
    <line x1="${ox}" y1="${oy-12}" x2="${ox+dW}" y2="${oy-12}" stroke="${dimColor}" stroke-width="1.4"/>
    <line x1="${ox}" y1="${oy-17}" x2="${ox}" y2="${oy-6}" stroke="${dimColor}" stroke-width="1.4"/>
    <line x1="${ox+dW}" y1="${oy-17}" x2="${ox+dW}" y2="${oy-6}" stroke="${dimColor}" stroke-width="1.4"/>
    <text x="${ox+dW/2}" y="${oy-15}" text-anchor="middle" font-size="${fs}" fill="${dimColor}" font-family="Inter,Arial,sans-serif" font-weight="700">${Math.round(X.size*10)} мм</text>
    <line x1="${ox+dW+12}" y1="${oy}" x2="${ox+dW+12}" y2="${oy+dH}" stroke="${dimColor}" stroke-width="1.4"/>
    <line x1="${ox+dW+6}" y1="${oy}" x2="${ox+dW+18}" y2="${oy}" stroke="${dimColor}" stroke-width="1.4"/>
    <line x1="${ox+dW+6}" y1="${oy+dH}" x2="${ox+dW+18}" y2="${oy+dH}" stroke="${dimColor}" stroke-width="1.4"/>
    <text x="${ox+dW+16}" y="${oy+dH/2}" text-anchor="middle" font-size="${fs}" fill="${dimColor}" font-family="Inter,Arial,sans-serif" font-weight="700" transform="rotate(90,${ox+dW+16},${oy+dH/2})">${Math.round(Y.size*10)} мм</text>
  `;
}

// --- Відображення інфо та ціни ---
function fmt(n) { return n.toLocaleString(T.locale) + ' ' + T.currency; }

function updatePanelUI(mode, panel, rowData) {
  const colorNames = T.colorNames;
  const facetNames = ['', '0', '5', '10', '15', '20'];

  const sizeLine = rowData.adjusted
    ? `<span>${T.panelSize} <b>${rowData.panelW}×${rowData.panelH} ${T.mm}</b> <span style="opacity:.7">${T.adjusted}</span></span>`
    : `<span>${T.panelSize} <b>${rowData.panelW}×${rowData.panelH} ${T.mm}</b></span>`;

  document.getElementById('info-' + mode).innerHTML = `
    ${sizeLine}
    <span>${T.tile} <b>${rowData.tileSizePrecise.toFixed(2)}×${rowData.tileSizePrecise.toFixed(2)} ${T.mm}</b></span>
    <span>${T.diagonals} <b>${rowData.d1.toFixed(2)}×${rowData.d2.toFixed(2)} ${T.mm}</b></span>
    <span>${T.grid} <b>${rowData.cols}×${rowData.rowCount}</b></span>
  `;

  document.getElementById('price-' + mode).innerHTML = `
    <span class="price-label">${T.priceLbl}</span> <span class="price-total">${fmt(rowData.total)}</span>
  `;

  // Зберігаємо для модалки
  panelData[mode] = { panel, rowData, colorName: colorNames[Number(panel.input.color)] || colorNames[1], facetName: facetNames[Number(panel.input.facet)] || '10' };
}

// --- Головний рендер ---
function getInput() {
  return {
    width:  Math.max(300, Math.min(5000, parseInt(document.getElementById('wallW').value) || 1500)),
    height: Math.max(300, Math.min(5000, parseInt(document.getElementById('wallH').value) || 2700)),
    facet:  Number(document.getElementById('facet').value),
    color:  Number(document.getElementById('color').value),
  };
}

function renderAll() {
  const input = getInput();
  MODES.forEach(mode => {
    const panel = generatePanel(mode, input, customCols[mode]);
    const rowData = generateRows(panel);
    drawPanel(mode, panel, rowData);
    updatePanelUI(mode, panel, rowData);
    checkZoomLimits(mode, input);
  });
}

// Розмір плитки (діагональна сторона, мм), що буде показано при заданому customC
function tileSizeFor(mode, input, customC) {
  const grid = Math.round((input.width / 10) / (CFG.gridAuto / 10)) + customC;
  if (grid < 1) return Infinity; // занадто велика плитка — заборонено
  const panel = generatePanel(mode, input, customC);
  return generateRows(panel).tileSize;
}

function checkZoomLimits(mode, input) {
  // обмеження саме за показаним розміром плитки: 200…600 мм
  const smaller = tileSizeFor(mode, input, customCols[mode] + 1); // − зробити дрібніше
  const bigger  = tileSizeFor(mode, input, customCols[mode] - 1); // + зробити крупніше
  document.getElementById('zoom-out-' + mode).disabled = smaller < CFG.tileMin;
  document.getElementById('zoom-in-' + mode).disabled  = bigger > CFG.tileMax;
  document.getElementById('reset-' + mode).disabled = customCols[mode] === 0;
}

// --- Кнопки зуму ---
MODES.forEach(mode => {
  // зменшити плитку (більше плиток)
  document.getElementById('zoom-out-' + mode).addEventListener('click', () => {
    const input = getInput();
    if (tileSizeFor(mode, input, customCols[mode] + 1) >= CFG.tileMin) {
      customCols[mode]++;
      renderAll();
    }
  });
  // збільшити плитку (менше плиток)
  document.getElementById('zoom-in-' + mode).addEventListener('click', () => {
    const input = getInput();
    if (tileSizeFor(mode, input, customCols[mode] - 1) <= CFG.tileMax) {
      customCols[mode]--;
      renderAll();
    }
  });
  document.getElementById('reset-' + mode).addEventListener('click', () => {
    customCols[mode] = 0;
    renderAll();
  });
});

// --- Модалка ---
function openModal(mode) {
  const { panel, rowData, colorName, facetName } = panelData[mode] || {};
  if (!rowData) return;

  const modeNames = { cover: '', cut: T.cutName, fit: T.fitName };
  document.getElementById('modalTitle').textContent =
    `Панно ${rowData.panelW}×${rowData.panelH} мм (${modeNames[mode]})`;

  document.getElementById('orderDiag').innerHTML =
    `${T.diagRhomb} <b>${rowData.d1.toFixed(2)} × ${rowData.d2.toFixed(2)} ${T.mm}</b>`;

  const formNames = { 1: T.fSquare, 1.3: T.fRhomb };
  const rows = rowData.rows.map(r => {
    const fName = r.triangle ? T.triangle : (formNames[r.form] || T.fSquare);
    return `<tr>
      <td>${fName}</td>
      <td class="num">${r.wLabel.toFixed(2)}×${r.hLabel.toFixed(2)}</td>
      <td class="num">${facetName} ${T.mm}</td>
      <td>${colorName}</td>
      <td class="num">${r.quantity} ${T.pcs}</td>
      <td class="num"><b class="cell-price">${fmt(r.price)}</b></td>
    </tr>`;
  }).join('');

  document.getElementById('orderTable').innerHTML = `
    <thead><tr><th>${T.thForm}</th><th class="num">${T.thSize}</th><th class="num">${T.thFacet}</th><th>${T.thColor}</th><th class="num">${T.thQty}</th><th class="num">${T.thPrice}</th></tr></thead>
    <tbody>${rows}<tr class="order-total"><td colspan="4">${T.totalLbl}</td><td class="num" colspan="2"><b class="cell-price">${fmt(rowData.total)}</b></td></tr></tbody>
  `;
  document.getElementById('orderModal').classList.add('open');
}

document.querySelectorAll('.panel-order').forEach(btn => {
  btn.addEventListener('click', () => openModal(btn.dataset.mode));
});
document.getElementById('closeModal').addEventListener('click', () =>
  document.getElementById('orderModal').classList.remove('open')
);
document.getElementById('orderModal').addEventListener('click', e => {
  if (e.target === document.getElementById('orderModal'))
    document.getElementById('orderModal').classList.remove('open');
});

document.getElementById('submitOrder').addEventListener('click', async () => {
  const btn = document.getElementById('submitOrder');
  const name = document.getElementById('modalName').value.trim();
  const phone = document.getElementById('modalPhone').value.trim();
  if (!name || !phone) { alert(T.alertNamePhone); return; }

  const title = document.getElementById('modalTitle').textContent || T.modalPanno;
  const diag = (document.getElementById('orderDiag').innerText || '').trim();
  const summary = ((diag ? diag + '\n' : '') + (document.getElementById('orderTable').innerText || '')).replace(/\s*\n\s*/g, '\n').trim();
  const key = document.querySelector('meta[name="w3f-key"]')?.content;
  if (!key || key === 'WEB3FORMS_ACCESS_KEY') {
    alert(T.alertNoForm);
    return;
  }

  const original = btn.textContent;
  btn.disabled = true; btn.textContent = T.sending;
  try {
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        access_key: key,
        subject: T.subject,
        from_name: 'euro-plitka.com.ua',
        [T.fName]: name,
        [T.fPhone]: phone,
        [T.fPanno]: title,
        [T.fCut]: summary,
      }),
    });
    const data = await res.json();
    if (data.success) {
      alert(T.success);
      document.getElementById('modalName').value = '';
      document.getElementById('modalPhone').value = '';
      document.getElementById('orderModal').classList.remove('open');
    } else {
      alert(T.failSend);
    }
  } catch (e) {
    alert(T.failNet);
  } finally {
    btn.disabled = false; btn.textContent = original;
  }
});

// --- Колір swatch ---
const swatchColors = { 1: '#c0c0c0', 2: '#cd7f32', 3: '#555' };
const colorSel = document.getElementById('color');
const swatch = document.getElementById('colorSwatch');
const updateSwatch = () => { swatch.style.background = swatchColors[colorSel.value] || '#c0c0c0'; };
colorSel.addEventListener('change', updateSwatch);
updateSwatch();

// --- Inputs ---
let debounce;
['wallW', 'wallH'].forEach(id => {
  document.getElementById(id).addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(renderAll, 400);
  });
  document.getElementById(id).addEventListener('change', renderAll);
});
['facet', 'color'].forEach(id =>
  document.getElementById(id).addEventListener('change', renderAll)
);

// Ініціалізація
renderAll();
</script>

<style>
