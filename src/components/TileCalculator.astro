  :global(#orderTable .cell-price) { font-weight: 800; color: var(--text); }
  :global(#orderTable .order-total td) { font-weight: 700; background: var(--gold-pale); color: var(--text); border-top: 2px solid rgba(0,0,0,0.18); }
  :global(#orderTable .order-total .cell-price) { font-size: 1.05rem; font-weight: 800; }

  .order-modal__form { display: flex; flex-direction: column; gap: 10px; }
  .order-modal__input {
    padding: 11px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.95rem;
